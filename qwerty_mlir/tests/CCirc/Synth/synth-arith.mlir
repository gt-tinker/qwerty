func.func @test() {
    %c0 = arith.constant 0 : i4
    %c1 = arith.constant 1 : i4
    %c2 = arith.constant 2 : i4
    %c3 = arith.constant 3 : i4
    %c4 = arith.constant 4 : i4
    %c5 = arith.constant 5 : i4
    %c6 = arith.constant 6 : i4
    %c7 = arith.constant 7 : i4
    %c8 = arith.constant 8 : i4
    %c9 = arith.constant 9 : i4
    %c10 = arith.constant 10 : i4
    %c11 = arith.constant 11 : i4
    %c12 = arith.constant 12 : i4
    %c13 = arith.constant 13 : i4
    %c14 = arith.constant 14 : i4
    %c15 = arith.constant 15 : i4
    // CHECK: 0
    func.call @check_add(%c0, %c0) : (i4, i4) -> () // 0x00 + 0x00 = 0x00
    // CHECK: 1
    func.call @check_add(%c0, %c1) : (i4, i4) -> () // 0x00 + 0x01 = 0x01
    // CHECK: 2
    func.call @check_add(%c0, %c2) : (i4, i4) -> () // 0x00 + 0x02 = 0x02
    // CHECK: 3
    func.call @check_add(%c0, %c3) : (i4, i4) -> () // 0x00 + 0x03 = 0x03
    // CHECK: 4
    func.call @check_add(%c0, %c4) : (i4, i4) -> () // 0x00 + 0x04 = 0x04
    // CHECK: 5
    func.call @check_add(%c0, %c5) : (i4, i4) -> () // 0x00 + 0x05 = 0x05
    // CHECK: 6
    func.call @check_add(%c0, %c6) : (i4, i4) -> () // 0x00 + 0x06 = 0x06
    // CHECK: 7
    func.call @check_add(%c0, %c7) : (i4, i4) -> () // 0x00 + 0x07 = 0x07
    // CHECK: -8
    func.call @check_add(%c0, %c8) : (i4, i4) -> () // 0x00 + 0x08 = 0x08
    // CHECK: -7
    func.call @check_add(%c0, %c9) : (i4, i4) -> () // 0x00 + 0x09 = 0x09
    // CHECK: -6
    func.call @check_add(%c0, %c10) : (i4, i4) -> () // 0x00 + 0x0a = 0x0a
    // CHECK: -5
    func.call @check_add(%c0, %c11) : (i4, i4) -> () // 0x00 + 0x0b = 0x0b
    // CHECK: -4
    func.call @check_add(%c0, %c12) : (i4, i4) -> () // 0x00 + 0x0c = 0x0c
    // CHECK: -3
    func.call @check_add(%c0, %c13) : (i4, i4) -> () // 0x00 + 0x0d = 0x0d
    // CHECK: -2
    func.call @check_add(%c0, %c14) : (i4, i4) -> () // 0x00 + 0x0e = 0x0e
    // CHECK: -1
    func.call @check_add(%c0, %c15) : (i4, i4) -> () // 0x00 + 0x0f = 0x0f
    // CHECK: 1
    func.call @check_add(%c1, %c0) : (i4, i4) -> () // 0x01 + 0x00 = 0x01
    // CHECK: 2
    func.call @check_add(%c1, %c1) : (i4, i4) -> () // 0x01 + 0x01 = 0x02
    // CHECK: 3
    func.call @check_add(%c1, %c2) : (i4, i4) -> () // 0x01 + 0x02 = 0x03
    // CHECK: 4
    func.call @check_add(%c1, %c3) : (i4, i4) -> () // 0x01 + 0x03 = 0x04
    // CHECK: 5
    func.call @check_add(%c1, %c4) : (i4, i4) -> () // 0x01 + 0x04 = 0x05
    // CHECK: 6
    func.call @check_add(%c1, %c5) : (i4, i4) -> () // 0x01 + 0x05 = 0x06
    // CHECK: 7
    func.call @check_add(%c1, %c6) : (i4, i4) -> () // 0x01 + 0x06 = 0x07
    // CHECK: -8
    func.call @check_add(%c1, %c7) : (i4, i4) -> () // 0x01 + 0x07 = 0x08
    // CHECK: -7
    func.call @check_add(%c1, %c8) : (i4, i4) -> () // 0x01 + 0x08 = 0x09
    // CHECK: -6
    func.call @check_add(%c1, %c9) : (i4, i4) -> () // 0x01 + 0x09 = 0x0a
    // CHECK: -5
    func.call @check_add(%c1, %c10) : (i4, i4) -> () // 0x01 + 0x0a = 0x0b
    // CHECK: -4
    func.call @check_add(%c1, %c11) : (i4, i4) -> () // 0x01 + 0x0b = 0x0c
    // CHECK: -3
    func.call @check_add(%c1, %c12) : (i4, i4) -> () // 0x01 + 0x0c = 0x0d
    // CHECK: -2
    func.call @check_add(%c1, %c13) : (i4, i4) -> () // 0x01 + 0x0d = 0x0e
    // CHECK: -1
    func.call @check_add(%c1, %c14) : (i4, i4) -> () // 0x01 + 0x0e = 0x0f
    // CHECK: 0
    func.call @check_add(%c1, %c15) : (i4, i4) -> () // 0x01 + 0x0f = 0x00
    // CHECK: 2
    func.call @check_add(%c2, %c0) : (i4, i4) -> () // 0x02 + 0x00 = 0x02
    // CHECK: 3
    func.call @check_add(%c2, %c1) : (i4, i4) -> () // 0x02 + 0x01 = 0x03
    // CHECK: 4
    func.call @check_add(%c2, %c2) : (i4, i4) -> () // 0x02 + 0x02 = 0x04
    // CHECK: 5
    func.call @check_add(%c2, %c3) : (i4, i4) -> () // 0x02 + 0x03 = 0x05
    // CHECK: 6
    func.call @check_add(%c2, %c4) : (i4, i4) -> () // 0x02 + 0x04 = 0x06
    // CHECK: 7
    func.call @check_add(%c2, %c5) : (i4, i4) -> () // 0x02 + 0x05 = 0x07
    // CHECK: -8
    func.call @check_add(%c2, %c6) : (i4, i4) -> () // 0x02 + 0x06 = 0x08
    // CHECK: -7
    func.call @check_add(%c2, %c7) : (i4, i4) -> () // 0x02 + 0x07 = 0x09
    // CHECK: -6
    func.call @check_add(%c2, %c8) : (i4, i4) -> () // 0x02 + 0x08 = 0x0a
    // CHECK: -5
    func.call @check_add(%c2, %c9) : (i4, i4) -> () // 0x02 + 0x09 = 0x0b
    // CHECK: -4
    func.call @check_add(%c2, %c10) : (i4, i4) -> () // 0x02 + 0x0a = 0x0c
    // CHECK: -3
    func.call @check_add(%c2, %c11) : (i4, i4) -> () // 0x02 + 0x0b = 0x0d
    // CHECK: -2
    func.call @check_add(%c2, %c12) : (i4, i4) -> () // 0x02 + 0x0c = 0x0e
    // CHECK: -1
    func.call @check_add(%c2, %c13) : (i4, i4) -> () // 0x02 + 0x0d = 0x0f
    // CHECK: 0
    func.call @check_add(%c2, %c14) : (i4, i4) -> () // 0x02 + 0x0e = 0x00
    // CHECK: 1
    func.call @check_add(%c2, %c15) : (i4, i4) -> () // 0x02 + 0x0f = 0x01
    // CHECK: 3
    func.call @check_add(%c3, %c0) : (i4, i4) -> () // 0x03 + 0x00 = 0x03
    // CHECK: 4
    func.call @check_add(%c3, %c1) : (i4, i4) -> () // 0x03 + 0x01 = 0x04
    // CHECK: 5
    func.call @check_add(%c3, %c2) : (i4, i4) -> () // 0x03 + 0x02 = 0x05
    // CHECK: 6
    func.call @check_add(%c3, %c3) : (i4, i4) -> () // 0x03 + 0x03 = 0x06
    // CHECK: 7
    func.call @check_add(%c3, %c4) : (i4, i4) -> () // 0x03 + 0x04 = 0x07
    // CHECK: -8
    func.call @check_add(%c3, %c5) : (i4, i4) -> () // 0x03 + 0x05 = 0x08
    // CHECK: -7
    func.call @check_add(%c3, %c6) : (i4, i4) -> () // 0x03 + 0x06 = 0x09
    // CHECK: -6
    func.call @check_add(%c3, %c7) : (i4, i4) -> () // 0x03 + 0x07 = 0x0a
    // CHECK: -5
    func.call @check_add(%c3, %c8) : (i4, i4) -> () // 0x03 + 0x08 = 0x0b
    // CHECK: -4
    func.call @check_add(%c3, %c9) : (i4, i4) -> () // 0x03 + 0x09 = 0x0c
    // CHECK: -3
    func.call @check_add(%c3, %c10) : (i4, i4) -> () // 0x03 + 0x0a = 0x0d
    // CHECK: -2
    func.call @check_add(%c3, %c11) : (i4, i4) -> () // 0x03 + 0x0b = 0x0e
    // CHECK: -1
    func.call @check_add(%c3, %c12) : (i4, i4) -> () // 0x03 + 0x0c = 0x0f
    // CHECK: 0
    func.call @check_add(%c3, %c13) : (i4, i4) -> () // 0x03 + 0x0d = 0x00
    // CHECK: 1
    func.call @check_add(%c3, %c14) : (i4, i4) -> () // 0x03 + 0x0e = 0x01
    // CHECK: 2
    func.call @check_add(%c3, %c15) : (i4, i4) -> () // 0x03 + 0x0f = 0x02
    // CHECK: 4
    func.call @check_add(%c4, %c0) : (i4, i4) -> () // 0x04 + 0x00 = 0x04
    // CHECK: 5
