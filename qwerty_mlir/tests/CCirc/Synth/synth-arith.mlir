    // CHECK: -4
    func.call @check_add(%c4, %c8) : (i4, i4) -> () // 0x04 + 0x08 = 0x0c
    // CHECK: -3
    func.call @check_add(%c4, %c9) : (i4, i4) -> () // 0x04 + 0x09 = 0x0d
    // CHECK: -2
    func.call @check_add(%c4, %c10) : (i4, i4) -> () // 0x04 + 0x0a = 0x0e
    // CHECK: -1
    func.call @check_add(%c4, %c11) : (i4, i4) -> () // 0x04 + 0x0b = 0x0f
    // CHECK: 0
    func.call @check_add(%c4, %c12) : (i4, i4) -> () // 0x04 + 0x0c = 0x00
    // CHECK: 1
